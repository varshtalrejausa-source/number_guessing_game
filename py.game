import tkinter as tk
import random

root = tk.Tk()
root.title("Number Guessing Game")
root.geometry("400x350")

secret_number = random.randint(1, 10)

title = tk.Label(root, text="🎯 Number Guessing Game", font=("Arial", 20))
title.pack(pady=20)

label = tk.Label(root, text="Guess a number between 1 and 10")
label.pack(pady=10)

guess_entry = tk.Entry(root, font=("Arial", 14))
guess_entry.pack(pady=10)

result = tk.Label(root, text="", font=("Arial", 12))
result.pack(pady=10)


def check_guess():
    global secret_number

    try:
        guess = int(guess_entry.get())

        if guess == secret_number:
            result.config(text="🎉 Correct!")
            play_again_button.config(state="normal")

        elif guess < secret_number:
            result.config(text="📈 Too low!")

        else:
            result.config(text="📉 Too high!")

    except ValueError:
        result.config(text="Enter a number from 1 to 10!")


def play_again():
    global secret_number

    secret_number = random.randint(1, 10)
    guess_entry.delete(0, tk.END)
    result.config(text="New number! 🎲")
    play_again_button.config(state="disabled")


guess_button = tk.Button(
    root,
    text="Guess",
    command=check_guess
)
guess_button.pack(pady=10)

play_again_button = tk.Button(
    root,
    text="Play Again",
    command=play_again,
    state="disabled"
)
play_again_button.pack(pady=10)

root.mainloop()
